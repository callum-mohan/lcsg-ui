---
/**
 * PlaceholderImage — renders an optimised image when one is supplied, or a
 * quiet "photo to follow" frame when it isn't.
 *
 * This lets the whole site be built before real photography arrives, while
 * clearly signalling where images belong. Pass an imported image to `src`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Aspect ratio as width/height, e.g. "4/3", "16/9", "1/1". */
  ratio?: string;
  /** Short caption shown inside the placeholder frame. Pass "" to hide. */
  caption?: string;
  /** Optional colour tint for the placeholder frame. */
  accent?: string;
  /** Hint for responsive sizing. */
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt = '',
  ratio = '4/3',
  caption = 'Photo to follow',
  accent,
  sizes = '(max-width: 48rem) 100vw, 600px',
  class: className = '',
  loading = 'lazy',
} = Astro.props;

const style = `--ratio:${ratio};${accent ? `--frame-accent:${accent};` : ''}`;
const label = caption || 'Photo to follow';
---

{src ? (
  <figure class={`ph ph--has-image ${className}`} style={style}>
    <Image
      src={src}
      alt={alt}
      sizes={sizes}
      loading={loading}
      class="ph__img"
    />
  </figure>
) : (
  <div
    class={`ph ph--empty ${className}`}
    style={style}
    role="img"
    aria-label={`${label} (placeholder)`}
  >
    <div class="ph__inner">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        aria-hidden="true"
        focusable="false"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
        stroke-linecap="round"
      >
        <path d="M4 7.5h3l1.6-2.5h6.8L17 7.5h3a1 1 0 0 1 1 1V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1z" />
        <circle cx="12" cy="13" r="3.5" />
      </svg>
      {caption && <span class="ph__caption">{caption}</span>}
    </div>
  </div>
)}

<style>
  .ph {
    margin: 0;
    aspect-ratio: var(--ratio, 4 / 3);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .ph__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ph--empty {
    display: grid;
    place-items: center;
    color: var(--ink-3);
    background: color-mix(
      in srgb,
      var(--frame-accent, transparent) 8%,
      var(--surface)
    );
  }
  .ph__inner {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1rem;
  }
  .ph__caption {
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
