---
/**
 * ActivityCard — an upcoming activity as a diary row: a bold date column,
 * then the title, practical details and the sections it is for.
 */
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../utils/format';
import PlaceholderImage from './PlaceholderImage.astro';
import SectionTag from './SectionTag.astro';

interface Props {
  entry: CollectionEntry<'activities'>;
  showImage?: boolean;
}

const { entry, showImage = false } = Astro.props;
const { data } = entry;
const part = (opts: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-GB', opts).format(data.date);
const weekday = part({ weekday: 'short' });
const day = part({ day: 'numeric' });
const month = part({ month: 'short' });
---

<article class="event">
  <time class="event__date" datetime={isoDate(data.date)}>
    <span class="event__month">{month}</span>
    <span class="event__day">{day}</span>
    <span class="event__weekday">{weekday}</span>
    <span class="visually-hidden">{formatDate(data.date)}</span>
  </time>

  <div class="event__body">
    <h3 class="event__title">
      {data.title}
      {data.sample && <span class="placeholder">Sample event</span>}
    </h3>

    {(data.time || data.location) && (
      <ul class="event__meta">
        {data.time && <li>{data.time}</li>}
        {data.location && <li>{data.location}</li>}
      </ul>
    )}

    <p class="event__desc">{data.description}</p>

    {data.sections.length > 0 && (
      <div class="event__sections">
        {data.sections.map((s) => (
          <SectionTag section={s} />
        ))}
      </div>
    )}

    {data.info && <p class="event__info">{data.info}</p>}
  </div>

  {showImage && (
    <div class="event__media">
      <PlaceholderImage
        src={data.image}
        alt={data.imageAlt}
        ratio="1/1"
        caption="Photo to follow"
      />
    </div>
  )}
</article>

<style>
  .event {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-md) clamp(1rem, 3vw, 2.5rem);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .event:has(.event__media) {
    grid-template-columns: 4.5rem 1fr auto;
  }

  .event__date {
    display: grid;
    align-content: start;
    line-height: 1;
  }
  .event__month,
  .event__weekday {
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .event__month {
    color: var(--badge-red);
  }
  .event__weekday {
    color: var(--ink-3);
    margin-top: 0.35rem;
  }
  .event__day {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-4);
    letter-spacing: -0.05em;
    margin-top: 0.15rem;
  }

  .event__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    margin: 0 0 0.4rem;
    font-size: var(--step-2);
  }

  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
    list-style: none;
    margin: 0 0 var(--space-sm);
    padding: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }
  .event__meta li {
    margin: 0;
  }

  .event__desc {
    margin: 0;
    color: var(--ink-2);
  }
  .event__sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-md);
  }
  .event__info {
    margin: var(--space-sm) 0 0;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .event__media {
    width: clamp(6rem, 18vw, 9rem);
  }

  @media (max-width: 34rem) {
    .event,
    .event:has(.event__media) {
      grid-template-columns: 3.5rem 1fr;
    }
    .event__media {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>
