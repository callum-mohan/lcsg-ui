---
/**
 * CompassBadge — recreates the group badge's four coloured quadrants as a
 * large compass, labelled with the outdoor activities pictured on the badge.
 * Purely decorative; the hub text should repeat information given elsewhere.
 */
interface Props {
  hubValue?: string;
  hubLabel?: string;
}

const { hubValue = '4–18', hubLabel = 'years' } = Astro.props;

const quadrants = [
  { pos: 'nw', label: 'Cycle', icon: 'bike' },
  { pos: 'ne', label: 'Climb', icon: 'mountain' },
  { pos: 'sw', label: 'Camp', icon: 'tent' },
  { pos: 'se', label: 'Paddle', icon: 'water' },
] as const;
---

<div class="compass" aria-hidden="true">
  <span class="compass__pt compass__pt--n">N</span>
  <span class="compass__pt compass__pt--e">E</span>
  <span class="compass__pt compass__pt--s">S</span>
  <span class="compass__pt compass__pt--w">W</span>

  <div class="compass__dial">
    {quadrants.map((q) => (
      <div class={`q q--${q.pos}`}>
        <span class="q__content">
          <svg
            aria-hidden="true"
            viewBox="0 0 32 32"
            width="34"
            height="34"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            {q.icon === 'bike' && (
              <>
                <circle cx="8" cy="21" r="5.5" />
                <circle cx="24" cy="21" r="5.5" />
                <path d="M8 21l5-9 3 9h-8m8 0l5-9h-8m8 0l3 9M13 12v-2.5m-2 0h4M21 12l-1-3.2h3" />
              </>
            )}
            {q.icon === 'mountain' && (
              <>
                <path d="M2.5 26L12 9.5l5.5 9.5 3.5-5.5L29.5 26z" />
                <path d="M9 14.8l3 1.7 2.6-2.4" />
              </>
            )}
            {q.icon === 'tent' && (
              <>
                <path d="M4 26L16 6l12 20z" />
                <path d="M12.6 26L16 19l3.4 7M2 26h28" />
              </>
            )}
            {q.icon === 'water' && (
              <path d="M3 11c2.2-2.4 4.4-2.4 6.5 0s4.3 2.4 6.5 0 4.3-2.4 6.5 0 4.3 2.4 6.5 0M3 17.5c2.2-2.4 4.4-2.4 6.5 0s4.3 2.4 6.5 0 4.3-2.4 6.5 0 4.3 2.4 6.5 0M3 24c2.2-2.4 4.4-2.4 6.5 0s4.3 2.4 6.5 0 4.3-2.4 6.5 0 4.3 2.4 6.5 0" />
            )}
          </svg>
          <span class="q__label">{q.label}</span>
        </span>
      </div>
    ))}

    <div class="compass__hub">
      <span class="compass__ages">{hubValue}</span>
      <span class="compass__unit">{hubLabel}</span>
    </div>
  </div>
</div>

<style>
  .compass {
    --gap: clamp(4px, 1.8cqi, 9px);
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1;
    margin-inline: auto;
    padding: 9%;
  }

  /* Outer bezel ring */
  .compass::before {
    content: "";
    position: absolute;
    inset: 4.5%;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .compass__pt {
    position: absolute;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(0.6rem, 3cqi, 0.85rem);
    letter-spacing: 0.08em;
    color: var(--ink-3);
    line-height: 1;
    background: var(--bg);
    padding: 0.3em;
  }
  .compass__pt--n {
    top: 4.5%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--ink);
  }
  .compass__pt--s {
    bottom: 4.5%;
    left: 50%;
    transform: translate(-50%, 50%);
  }
  .compass__pt--e {
    right: 4.5%;
    top: 50%;
    transform: translate(50%, -50%);
  }
  .compass__pt--w {
    left: 4.5%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .compass__dial {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    width: 100%;
    height: 100%;
  }

  .q {
    position: relative;
    display: grid;
    border-radius: 6px;
    transition: transform 0.5s var(--ease);
  }
  .q--nw {
    background: var(--badge-green);
    border-top-left-radius: 100%;
  }
  .q--ne {
    background: var(--badge-red);
    border-top-right-radius: 100%;
    color: #fff;
  }
  .q--sw {
    background: var(--badge-yellow);
    border-bottom-left-radius: 100%;
  }
  .q--se {
    background: var(--badge-blue);
    border-bottom-right-radius: 100%;
  }

  /* Content sits on the quadrant's diagonal, clear of the hub. */
  .q__content {
    position: absolute;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    transform: translate(-50%, -50%);
  }
  .q--nw .q__content {
    left: 56%;
    top: 56%;
  }
  .q--ne .q__content {
    left: 44%;
    top: 56%;
  }
  .q--sw .q__content {
    left: 56%;
    top: 44%;
  }
  .q--se .q__content {
    left: 44%;
    top: 44%;
  }
  .q svg {
    width: clamp(1.1rem, 9cqi, 2.4rem);
    height: auto;
  }

  .q__label {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(0.55rem, 3.8cqi, 1rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }

  .compass__hub {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-content: center;
    justify-items: center;
    width: 32%;
    aspect-ratio: 1;
    background: var(--bg);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 var(--gap) var(--bg);
  }
  .compass__ages {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 10.5cqi, 2.75rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .compass__unit {
    margin-top: 0.3em;
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 118%;
    font-size: clamp(0.5rem, 2.6cqi, 0.75rem);
    white-space: nowrap;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (hover: hover) {
    .compass:hover .q--nw {
      transform: translate(-3px, -3px);
    }
    .compass:hover .q--ne {
      transform: translate(3px, -3px);
    }
    .compass:hover .q--sw {
      transform: translate(-3px, 3px);
    }
    .compass:hover .q--se {
      transform: translate(3px, 3px);
    }
  }
</style>
